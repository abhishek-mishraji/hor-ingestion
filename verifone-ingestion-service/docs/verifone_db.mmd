        int ticket_count
        boolean mws_enabled
    }
    CPJ_PERIOD_CLOSES {
        bigint cpj_file_id PK, FK
        int period_type PK "1 shift, 2 day"
        int period_seq PK
        text period_name
        timestamptz closed_at
        text unique_id
        boolean mws_enabled
    }
    CPJ_TICKETS {
        bigint ticket_id PK
        bigint cpj_file_id FK, UK
        int seq_in_file UK "journal trans counted"
        text trans_type "sale, network sale, refund sale, ..."
        boolean is_suspended
        boolean is_fuel_prepay
        boolean is_rollback
        boolean is_prepay_completion
        boolean is_recalled
        bigint register_id FK
        bigint tr_seq "ticket number"
        text term_msg_type
        int terminal_no
        bigint term_msg_sn
        text unique_id
        bigint unique_sn
        timestamptz ticket_at
        int duration_sec

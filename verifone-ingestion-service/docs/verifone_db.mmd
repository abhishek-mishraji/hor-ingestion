%% ======================= columns: ingest =======================
    INGEST_FETCH_REQUESTS {
        bigint fetch_request_id PK
        bigint store_id FK
        text file_type "CPJ"
        date business_date
        text mode "REPLACE or REFUSE"
        bigint requested_by "admin_id snapshot"
        text requested_by_type "ADMIN or STORE_USER"
        text requested_by_name "actor name snapshot"
        timestamptz requested_at
        text status "RUNNING LOADED REFUSED NOT_FOUND FAILED"
        bigint s3_object_id FK "set when LOADED"
        timestamptz finished_at "NULL while RUNNING"
        text message "error or result summary"
    }
    INGEST_S3_OBJECTS {
        bigint s3_object_id PK
        bigint store_id FK
        text file_type "CPJ"
        date business_date
        int version_no "_vN, highest wins"
        text bucket UK
        text object_key UK "matches _CPJ_date_vN.zip"
        text etag UK
        bigint size_bytes
        timestamptz last_modified
        timestamptz manifest_created_at
        text mirror_version "fastMirrorVersion"
        timestamptz downloaded_at
    }
    INGEST_S3_OBJECT_FILES {
        bigint s3_object_id PK, FK
        text file_path PK "e.g. CPJ/CPJ2026-10-11-617.xml"
        bigint size_bytes
        char64 sha256 "SHA-256 verified against manifest"
        timestamptz modified_at
    }

%% ======================= columns: cpj =======================
    CPJ_CPJ_FILES {
        bigint cpj_file_id PK
        bigint store_id FK, UK
        date business_date UK
        int day_seq UK "transSet shortId"
        bigint s3_object_id FK "with store_id + business_date"
        text file_path FK
        bigint fetch_request_id FK
        int period_id
        text period_name "Day"
        timestamptz period_long_id
        text site_id "every storeNumber equals it"
        timestamptz opened_at
        timestamptz closed_at
        timestamptz loaded_at
    }
    CPJ_FILE_TOTALS {
        bigint cpj_file_id PK, FK
        text totals_kind PK "START or END"
        numeric inside_sales
        numeric inside_grand
        numeric outside_sales
        numeric outside_grand
        numeric attendant_inside_sales
        numeric attendant_inside_grand
        numeric attendant_outside_sales
        numeric attendant_outside_grand
        numeric overall_sales "POS counter check"
        numeric overall_grand
    }
    CPJ_LOAD_CHECKS {
        bigint cpj_file_id PK, FK
        text check_name PK
        numeric expected
        numeric actual
        boolean passed
        text detail "starts hard: or soft:"
    }
    CPJ_CASHIER_SESSIONS {
        bigint cashier_session_id PK
        bigint cpj_file_id FK, UK
        bigint register_id FK, UK
        bigint cashier_version_id FK
        int cashier_period UK
        int drawer
        timestamptz opened_at
        numeric begin_cash
        int begin_cash_mop_code
        int begin_cash_mop_cat
        timestamptz closed_at
        numeric close_begin_cash
        numeric close_begin_food_stamp

# verifone-ingestion-service settings. Copy to .env (never committed) and fill in.
# Format: KEY=VALUE, read as a Java properties file -> use forward slashes in paths (C:/data/cpj),
# and no quotes. Real environment variables with the same name override this file (production).

# Database (development: one login, auth_svc, owns auth_db, verifone_db, verifone_db_test)
HOR_DB_HOST=localhost
HOR_DB_PORT=5432
HOR_DB_USERNAME=auth_svc
HOR_DB_PASSWORD=

# AWS read-only key for bucket hor-stores-data
HOR_AWS_ACCESS_KEY_ID=
HOR_AWS_SECRET_ACCESS_KEY=

# s3 (real bucket) or local (folder laid out like the bucket)
HOR_STORAGE_MODE=s3

# Optional: folder with the real CPJ test days (golden tests skip when empty)
HOR_TESTDATA_ROOT=

# Web origins allowed to send write requests (exact, or patterns like https://*.example.com, http://localhost:*).
# Default: http://localhost:5182,http://127.0.0.1:5182   Production: https://ingestion.handsoffretail.com
#HOR_ALLOWED_ORIGINS=

# gilbarco-ingestion-service settings. Copy to .env (never committed) and fill in.
# Format: KEY=VALUE, read as a Java properties file -> use forward slashes in paths (C:/data/pjr),
# and no quotes. Real environment variables with the same name override this file (production).

# Database (development: one login, auth_svc, owns auth_db, gilbarco_db, gilbarco_db_test)
HOR_DB_HOST=localhost
HOR_DB_PORT=5432
HOR_DB_USERNAME=auth_svc
HOR_DB_PASSWORD=

# AWS read-only key for bucket hor-stores-data
HOR_AWS_ACCESS_KEY_ID=
HOR_AWS_SECRET_ACCESS_KEY=

# s3 (real bucket) or local (folder laid out like the bucket)
HOR_STORAGE_MODE=s3

# Optional: folder with real PJR test days (golden tests skip when empty)
HOR_TESTDATA_ROOT=
